    33: return 32'hffffd3f9;  // layer 2 neuron 1
    34: return 32'hffff9b65;  // layer 2 neuron 2
    35: return 32'hfffffe22;  // layer 2 neuron 3
    48: return 32'h00000ebc;  // layer 3 neuron 0
    default: return 32'h0;
  endcase
endfunction
