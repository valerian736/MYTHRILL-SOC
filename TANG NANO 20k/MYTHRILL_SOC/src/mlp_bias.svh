    16: return 32'hffff16f7;  // layer 1 neuron 0
    17: return 32'h0000ecbf;  // layer 1 neuron 1
    18: return 32'h0000cff1;  // layer 1 neuron 2
    19: return 32'hffffee6e;  // layer 1 neuron 3
